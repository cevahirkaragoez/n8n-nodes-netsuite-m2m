{
  "name": "n8n-nodes-netsuite-m2m",
  "version": "0.1.0",
  "description": "Independent NetSuite community node supporting OAuth 1.0 TBA and OAuth 2.0 M2M",
  "license": "MIT",
  "homepage": "https://github.com/cevahirkaragoez/n8n-nodes-netsuite-m2m",
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "cevahirkaragoez"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cevahirkaragoez/n8n-nodes-netsuite-m2m.git"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && gulp",
    "lint": "eslint nodes credentials transport",
    "lintfix": "eslint nodes credentials transport --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "n8n",
    "node",
    "netsuite",
    "rest",
    "api",
    "suitetalk",
    "n8n-node",
    "n8n-community-node-package"
  ],
  "contributors": [
    "Nicholas Penree (@drudge)",
    "Ian Dela Cruz (@ianpogi5)",
    "David Rowley (@drowl87)"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NetSuiteM2M.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NetSuite/NetSuite.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/config-array": "^0.20.0",
    "@eslint/js": "^9.26.0",
    "@eslint/object-schema": "^2.1.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "globals": "^15.15.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@drowl87/netsuite-rest-api-client": "^1.0.2",
    "p-limit": "^3.1.0"
  },
  "bugs": {
    "url": "https://github.com/cevahirkaragoez/n8n-nodes-netsuite-m2m/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}